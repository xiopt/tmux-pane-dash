#!/usr/bin/env bash
# tests/stubs/tmux — fake tmux for bats tests.
# Data layout under $TMUX_STUB_DIR:
#   panes                      one pane id per line (%0, %1, ...)
#   global/<option-name>       value of a global option (show-option -gqv)
#   server-options/<name>/<i>  indexed server option entries (show-options -s)
#   panes.d/<pane>/<key>       value for format '#{key}' (display-message -p -t)
# Mutations are appended to calls.log as unit-separator-delimited argv records.
# Query invocations are kept in invocations.log; notifications are separate.
set -euo pipefail

log_args() {
  local file="$1"
  shift
  printf '%s\037' "$@" >> "$TMUX_STUB_DIR/$file"
  printf '\n' >> "$TMUX_STUB_DIR/$file"
}

cmd="${1:-}"
case "$cmd" in
  list-panes)
    log_args invocations.log "$@"
    format=""
    while [ "$#" -gt 0 ]; do
      if [ "$1" = "-F" ]; then format="$2"; break; fi
      shift
    done
    if [ -z "$format" ]; then
      cat "$TMUX_STUB_DIR/panes"
      exit 0
    fi
    while IFS= read -r pane; do
      rest="$format"
      rendered=""
      while [[ "$rest" == *'#{'* ]]; do
        prefix="${rest%%\#\{*}"
        rest="${rest#*\#\{}"
        key="${rest%%\}*}"
        rest="${rest#*\}}"
        case "$key" in
          pane_id) value="$pane" ;;
          *) value="$(cat "$TMUX_STUB_DIR/panes.d/$pane/$key" 2>/dev/null || true)" ;;
        esac
        rendered+="$prefix$value"
      done
      printf '%s%s\n' "$rendered" "$rest"
    done < "$TMUX_STUB_DIR/panes" ;;
  show-option | show-options) # show-option -gq <name> | show-option -gqv <name> | show-options -s[v] <name> | show-option -pqv -t <pane> <name>
    log_args invocations.log "$@"
    if [ "$2" = "-gq" ]; then
      if [ -e "$TMUX_STUB_DIR/global/$3" ]; then
        value="$(<"$TMUX_STUB_DIR/global/$3")"
        if [ -n "$value" ]; then
          printf '%s %s\n' "$3" "$value"
        else
          printf "%s ''\n" "$3"
        fi
      fi
    elif [ "$2" = "-gqv" ]; then
      cat "$TMUX_STUB_DIR/global/$3" 2>/dev/null || true
    elif [ "$2" = "-sv" ]; then
      option_dir="$TMUX_STUB_DIR/server-options/$3"
      if [ -d "$option_dir" ]; then
        for entry in "$option_dir"/*; do
          [ -f "$entry" ] || continue
          cat "$entry"
          printf '\n'
        done
      fi
    elif [ "$2" = "-s" ]; then
      option_dir="$TMUX_STUB_DIR/server-options/$3"
      if [ -d "$option_dir" ]; then
        for entry in "$option_dir"/*; do
          [ -f "$entry" ] || continue
          printf '%s[%s] %s\n' "$3" "$(basename "$entry")" "$(<"$entry")"
        done
      fi
    else                     # -pqv -t <pane> <name>
      cat "$TMUX_STUB_DIR/panes.d/$4/$5" 2>/dev/null || true
    fi ;;
  show-hooks)
    log_args invocations.log "$@"
    hook_dir="$TMUX_STUB_DIR/hooks"
    if [ -d "$hook_dir" ]; then
      for entry in "$hook_dir"/"$3"\[*\]; do
        [ -f "$entry" ] || continue
        printf '%s %s\n' "$(basename "$entry")" "$(<"$entry")"
      done
    fi ;;
  display-message)          # display-message -p -t <pane> '<fmt>'
    if [ "${2:-}" = "-p" ]; then
      log_args invocations.log "$@"
      pane="$4"; fmt="$5"
      key="${fmt#\#\{}"; key="${key%\}}"
      # Match tmux 3.7b: an unknown target can succeed with empty output.
      if [ -f "$TMUX_STUB_DIR/panes.d/$pane/$key" ]; then
        cat "$TMUX_STUB_DIR/panes.d/$pane/$key"
      fi
    else
      log_args notifications.log "$@"
    fi ;;
  set-hook)
    log_args calls.log "$@"
    mkdir -p "$TMUX_STUB_DIR/hooks"
    if [ "$2" = "-ag" ]; then
      index=0
      while [ -e "$TMUX_STUB_DIR/hooks/$3[$index]" ]; do index=$((index + 1)); done
      printf '%s' "$4" > "$TMUX_STUB_DIR/hooks/$3[$index]"
    else
      printf '%s' "$4" > "$TMUX_STUB_DIR/hooks/$3"
    fi ;;
  set-option)
    log_args calls.log "$@"
    case "${2:-}" in
      -g)
        mkdir -p "$(dirname "$TMUX_STUB_DIR/global/$3")"
        printf '%s' "$4" > "$TMUX_STUB_DIR/global/$3" ;;
      -as)
        mkdir -p "$(dirname "$TMUX_STUB_DIR/global/$3")"
        current="$(cat "$TMUX_STUB_DIR/global/$3" 2>/dev/null || true)"
        printf '%s%s' "$current" "$4" > "$TMUX_STUB_DIR/global/$3" ;;
      -s)
        option="${3%%\[*}"
        index="${3#*\[}"
        index="${index%\]}"
        mkdir -p "$TMUX_STUB_DIR/server-options/$option"
        printf '%s' "$4" > "$TMUX_STUB_DIR/server-options/$option/$index" ;;
      -sa)
        option="$3"
        index=0
        mkdir -p "$TMUX_STUB_DIR/server-options/$option"
        while [ -e "$TMUX_STUB_DIR/server-options/$option/$index" ]; do index=$((index + 1)); done
        printf '%s' "$4" > "$TMUX_STUB_DIR/server-options/$option/$index" ;;
    esac ;;
  *)
    log_args calls.log "$@" ;;
esac
